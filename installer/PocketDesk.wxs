<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="PocketDesk"
           Manufacturer="PocketDesk"
           Version="1.1.3"
           UpgradeCode="C0C27D7D-6E42-4E5A-A621-0B1F0F7F7E11"
           Scope="perUser"
           Compressed="yes"
           Codepage="936"
           Language="2052">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="已安装更新版本的 PocketDesk。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseFile)" />
    <ui:WixUI Id="WixUI_FeatureTree" />

    <Icon Id="AppIcon" SourceFile="$(var.PublishDir)\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPCOMMENTS" Value="桌面原生收纳层" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="PocketDesk" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuDir" Name="PocketDesk" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Directory Id="DesktopDir" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles">
      <Files Include="$(var.PublishDir)\**" Directory="INSTALLFOLDER" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="AppMenuDir" Guid="8A3A65D2-1E3D-4F7B-8C63-6A4F6E0E4B31">
      <Shortcut Id="PocketDeskStartMenuShortcut"
                Name="PocketDesk"
                Description="桌面原生收纳层"
                Target="[INSTALLFOLDER]PocketDesk.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppMenuDir" Directory="AppMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\PocketDesk" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopDir" Guid="6F2E7D6B-0C2A-46D0-9C3B-2C8A3F31B2A4">
      <Shortcut Id="PocketDeskDesktopShortcut"
                Name="PocketDesk"
                Description="桌面原生收纳层"
                Target="[INSTALLFOLDER]PocketDesk.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\PocketDesk" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="PocketDesk 主程序" Description="PocketDesk 桌面收纳层及开始菜单快捷方式。" Level="1" Display="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Feature Id="DesktopShortcutFeature" Title="桌面快捷方式" Description="在桌面创建 PocketDesk 快捷方式（可取消勾选）。" Level="1" Display="2">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- 卸载前清理自启项；PocketDesk 是 WinExe，不会弹出控制台窗口。 -->
    <CustomAction Id="UninstallCleanup"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]PocketDesk.exe&quot; --uninstall=keep"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="UninstallCleanup" Before="RemoveFiles" Condition='REMOVE~="ALL"' />
    </InstallExecuteSequence>
  </Package>
</Wix>
