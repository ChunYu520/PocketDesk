<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PocketDesk.BoxManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PocketDesk"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="收纳盒管理器">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="收纳盒管理器" Subtitle="管理桌面收纳盒与分组">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Padding="20,10,20,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="NewButton" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="新建收纳盒" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="普通收纳盒（文件移入应用目录）" Click="OnCreateNormal">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="映射收纳盒（只记录路径）" Click="OnCreateMapped">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE71B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="目标收纳盒（绑定现有文件夹）" Click="OnCreateTarget">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8DA;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button Content="显示全部" Click="OnShowAll" />
                <Button Content="隐藏全部" Click="OnHideAll" />
                <Button Content="贴边排列" Click="OnTile" />
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Opacity="0.6" Margin="8,0,0,0" />
            </StackPanel>

            <ListView x:Name="BoxesList"
                      Grid.Row="1"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="OnBoxClick"
                      AllowDrop="False">
                <ListView.Header>
                    <Grid Padding="12,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="类型" FontSize="11" Opacity="0.55" />
                        <TextBlock Grid.Column="1" Text="名称" FontSize="11" Opacity="0.55" />
                        <TextBlock Grid.Column="2" Text="项目" FontSize="11" Opacity="0.55" />
                        <TextBlock Grid.Column="3" Text="状态" FontSize="11" Opacity="0.55" />
                        <TextBlock Grid.Column="4" Text="位置" FontSize="11" Opacity="0.55" />
                        <TextBlock Grid.Column="5" Text="创建时间" FontSize="11" Opacity="0.55" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:BoxRow">
                        <Grid Padding="12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="16" Opacity="0.8" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind TypeLabel}" FontSize="11" Opacity="0.55" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind CountText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7B3;" FontSize="11" Opacity="0.7" />
                                <TextBlock Text="{x:Bind VisibilityText}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Column="4"
                                       Text="{x:Bind PathText}"
                                       FontSize="12"
                                       Opacity="0.65"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5"
                                       Text="{x:Bind CreatedText}"
                                       FontSize="11"
                                       Opacity="0.55"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyHint" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE8B7;" FontSize="40" Opacity="0.3" HorizontalAlignment="Center" />
                <TextBlock Text="还没有收纳盒" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock Text="点击“新建收纳盒”，把常用文件收到桌面上。"
                           FontSize="12"
                           Opacity="0.6"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="OpenButton" Content="打开" Click="OnOpen" IsEnabled="False" />
                <Button x:Name="RenameButton" Content="重命名" Click="OnRename" IsEnabled="False" />
                <Button x:Name="AppearanceButton" Content="外观" Click="OnAppearance" IsEnabled="False" />
                <Button x:Name="ShowButton" Content="显示" Click="OnShow" IsEnabled="False" />
                <Button x:Name="HideButton" Content="隐藏" Click="OnHide" IsEnabled="False" />
                <Button x:Name="UpButton" Content="上移" Click="OnMoveUp" IsEnabled="False" />
                <Button x:Name="DownButton" Content="下移" Click="OnMoveDown" IsEnabled="False" />
                <Button x:Name="DeleteButton" Content="删除" Click="OnDelete" IsEnabled="False" />
                <Button Content="设置" Click="OnOpenSettings" Margin="12,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
