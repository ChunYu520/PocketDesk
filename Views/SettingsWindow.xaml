<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PocketDesk.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PocketDesk"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="设置">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="设置" Subtitle="PocketDesk">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneOpen="True"
                        OpenPaneLength="176"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="常规" Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="外观" Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="行为" Tag="behavior">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="存储" Tag="storage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="24,8,24,24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>

                        <!-- 常规 -->
                        <StackPanel x:Name="GeneralSection" Spacing="14">
                            <TextBlock Text="常规" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="18">
                                    <ToggleSwitch x:Name="StartupToggle"
                                                  Header="开机自启"
                                                  OnContent="已启用"
                                                  OffContent="已禁用"
                                                  Toggled="OnStartupToggled" />
                                    <ComboBox x:Name="CloseBehaviorCombo"
                                              Header="关闭收纳盒窗口时"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OnCloseBehaviorChanged">
                                        <ComboBoxItem Content="最小化到托盘，继续在后台运行" />
                                        <ComboBoxItem Content="退出 PocketDesk" />
                                    </ComboBox>
                                    <ToggleSwitch x:Name="RestoreLayoutToggle"
                                                  Header="启动时恢复上次布局"
                                                  OnContent="恢复"
                                                  OffContent="不恢复"
                                                  Toggled="OnRestoreLayoutToggled" />
                                </StackPanel>
                            </Border>

                            <InfoBar IsOpen="True"
                                     IsClosable="False"
                                     Severity="Informational"
                                     Title="磁力访问窗与快速面板"
                                     Message="这两项能力计划在首个更新中提供，当前版本尚未包含。" />
                        </StackPanel>

                        <!-- 外观 -->
                        <StackPanel x:Name="AppearanceSection" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="外观" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="18">
                                    <ComboBox x:Name="MaterialCombo"
                                              Header="默认材质"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OnMaterialChanged">
                                        <ComboBoxItem Content="Mica（云母，与壁纸融合）" />
                                        <ComboBoxItem Content="DesktopAcrylic（亚克力，更通透）" />
                                        <ComboBoxItem Content="纯色（最高可读性）" />
                                    </ComboBox>
                                    <ComboBox x:Name="ThemeCombo"
                                              Header="主题"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OnThemeChanged">
                                        <ComboBoxItem Content="跟随系统" />
                                        <ComboBoxItem Content="浅色" />
                                        <ComboBoxItem Content="深色" />
                                    </ComboBox>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="默认图标大小" FontSize="12" Opacity="0.75" />
                                        <Slider x:Name="IconSizeSlider" Minimum="24" Maximum="96"
                                                StepFrequency="4" ValueChanged="OnAppearanceSliderChanged" />
                                        <TextBlock x:Name="IconSizeValue" FontSize="11" Opacity="0.6" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="默认外框圆角" FontSize="12" Opacity="0.75" />
                                        <Slider x:Name="RadiusSlider" Minimum="0" Maximum="24"
                                                StepFrequency="1" ValueChanged="OnAppearanceSliderChanged" />
                                        <TextBlock x:Name="RadiusValue" FontSize="11" Opacity="0.6" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="默认背景不透明度" FontSize="12" Opacity="0.75" />
                                        <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1"
                                                StepFrequency="0.05" ValueChanged="OnAppearanceSliderChanged" />
                                        <TextBlock x:Name="OpacityValue" FontSize="11" Opacity="0.6" />
                                    </StackPanel>

                                    <Button Content="把默认外观应用到所有收纳盒" Click="OnApplyDefaultsToAll" />
                                    <TextBlock Text="每个收纳盒仍可在自己的右键菜单 → 外观中单独调整，并会覆盖这里的默认值。"
                                               FontSize="11"
                                               Opacity="0.6"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 行为 -->
                        <StackPanel x:Name="BehaviorSection" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="行为" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="18">
                                    <ToggleSwitch x:Name="ConfirmDeleteToggle"
                                                  Header="删除前二次确认"
                                                  OnContent="需要确认"
                                                  OffContent="直接删除"
                                                  Toggled="OnConfirmDeleteToggled" />
                                    <ComboBox x:Name="UndoCombo"
                                              Header="撤销删除的时长"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OnUndoChanged">
                                        <ComboBoxItem Content="5 秒" />
                                        <ComboBoxItem Content="10 秒" />
                                        <ComboBoxItem Content="30 秒" />
                                    </ComboBox>
                                    <TextBlock Text="删除普通收纳盒中的项目时，文件会先还原到原位置，再在托盘上方提供撤销入口。"
                                               FontSize="11"
                                               Opacity="0.6"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 存储 -->
                        <StackPanel x:Name="StorageSection" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="存储" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="数据目录" FontSize="12" Opacity="0.65" />
                                        <TextBlock x:Name="DataDirText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="普通收纳盒文件根目录" FontSize="12" Opacity="0.65" />
                                        <TextBlock x:Name="StorageDirText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="打开数据目录" Click="OnOpenDataDir" />
                                        <Button Content="打开普通盒根目录" Click="OnOpenStorageDir" />
                                    </StackPanel>
                                    <TextBlock Text="数据库使用 SQLite + WAL；执行 schema 迁移前会自动备份最近 3 份数据库。"
                                               FontSize="11"
                                               Opacity="0.6"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="诊断" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="导出最近日志与运行环境摘要（不包含文件内容，路径已脱敏）。"
                                               FontSize="12"
                                               Opacity="0.65"
                                               TextWrapping="Wrap" />
                                    <Button Content="导出诊断日志" Click="OnExportLogs" />
                                    <TextBlock x:Name="ExportResultText" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 关于 -->
                        <StackPanel x:Name="AboutSection" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="关于" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="PocketDesk" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.65" />
                                    <TextBlock Text="桌面上的原生收纳层，而不是另一个文件管理器。"
                                               FontSize="13"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="普通收纳盒会真实移动文件，删除时自动还原到原位置；映射收纳盒只保存路径引用，绝不修改源文件。"
                                               FontSize="12"
                                               Opacity="0.65"
                                               TextWrapping="Wrap" />
                                    <Button Content="检查更新" IsEnabled="False" ToolTipService.ToolTip="更新服务尚未配置" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="隐私" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="应用不联网（除手动检查更新），不收集文件内容或路径。诊断日志仅包含应用状态与异常堆栈，导出时会脱敏用户目录。"
                                               FontSize="12"
                                               Opacity="0.65"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="开源组件" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Windows App SDK（MIT）、.NET（MIT）、SQLite（Public Domain）、SQLitePCLRaw（Apache-2.0）。"
                                               FontSize="12"
                                               Opacity="0.65"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
