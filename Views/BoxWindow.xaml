<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PocketDesk.BoxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PocketDesk"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PocketDesk">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
        <ItemsPanelTemplate x:Key="GridPanelTemplate">
            <ItemsWrapGrid Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="ListPanelTemplate">
            <ItemsStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="GridItemTemplate" x:DataType="local:BoxItem">
            <Grid Padding="4"
                  AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                  ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Width="{x:Bind IconSize, Mode=OneWay}"
                      Height="{x:Bind IconSize, Mode=OneWay}"
                      HorizontalAlignment="Center">
                    <FontIcon Glyph="{x:Bind KindGlyph}"
                              FontSize="{x:Bind IconSize, Mode=OneWay}"
                              Opacity="0.28"
                              Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    <Image Source="{x:Bind Icon, Mode=OneWay}"
                           Width="{x:Bind IconSize, Mode=OneWay}"
                           Height="{x:Bind IconSize, Mode=OneWay}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE71B;"
                              FontSize="10"
                              Visibility="{x:Bind LinkVisibility}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <FontIcon Glyph="&#xE783;"
                              FontSize="14"
                              Visibility="{x:Bind MissingVisibility}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{x:Bind DisplayName, Mode=OneWay}"
                           Margin="2,6,2,0"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="{x:Bind NameLines, Mode=OneWay}"
                           Visibility="{x:Bind NameVisibility, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ListItemTemplate" x:DataType="local:BoxItem">
            <Grid Padding="10,6" ColumnSpacing="10"
                  AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                  ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="32" Height="32">
                    <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="22" Opacity="0.28"
                              Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                    <Image Source="{x:Bind Icon, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <TextBlock Text="{x:Bind TypeHint}"
                               FontSize="11"
                               Opacity="0.6"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE71B;" FontSize="11" Visibility="{x:Bind LinkVisibility}"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <FontIcon Glyph="&#xE783;" FontSize="13" Visibility="{x:Bind MissingVisibility}"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 背景层：半透明材质底色 -->
        <Border x:Name="BackgroundLayer"
                Grid.RowSpan="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                IsHitTestVisible="False" />
        <Border x:Name="BorderLayer"
                Grid.RowSpan="3"
                BorderThickness="1"
                CornerRadius="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                IsHitTestVisible="False" />

        <!-- 自绘标题栏 -->
        <Grid x:Name="TitleBarHost" Grid.Row="0" Height="44" Padding="10,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="DragArea" Background="Transparent" DoubleTapped="OnTitleDoubleTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="TypeIcon" Glyph="&#xE8B7;" FontSize="13" Opacity="0.7"
                          VerticalAlignment="Center" Margin="2,0,8,0" />
                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="AddButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="收纳文件…"
                        AutomationProperties.Name="收纳文件"
                        Click="OnAddClick">
                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                </Button>
                <Button x:Name="RollButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="卷起"
                        AutomationProperties.Name="卷起或展开"
                        Click="OnRollClick">
                    <FontIcon x:Name="RollGlyph" Glyph="&#xE70E;" FontSize="11" />
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="关闭（仍在托盘运行）"
                        AutomationProperties.Name="关闭收纳盒"
                        Click="OnCloseClick">
                    <FontIcon Glyph="&#xE8BB;" FontSize="11" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 内容区 -->
        <Grid x:Name="ContentRoot" Grid.Row="1">
            <ListView x:Name="ItemsView"
                      Background="Transparent"
                      Padding="8,2,8,8"
                      SelectionMode="Extended"
                      AllowDrop="True"
                      CanDragItems="True"
                      CanReorderItems="False"
                      IsItemClickEnabled="False"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.Name="收纳盒内容"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      DragEnter="OnDragEnter"
                      DragOver="OnDragOver"
                      DragLeave="OnDragLeave"
                      Drop="OnDrop"
                      DragItemsStarting="OnDragItemsStarting"
                      SelectionChanged="OnSelectionChanged"
                      DoubleTapped="OnItemDoubleTapped"
                      RightTapped="OnListRightTapped"
                      KeyDown="OnListKeyDown"
                      SizeChanged="OnItemsViewSizeChanged">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>

            <!-- 框选覆盖层 -->
            <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                <Border x:Name="SelectionRect"
                        Visibility="Collapsed"
                        Background="#332B88FF"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="2" />
            </Canvas>

            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        IsHitTestVisible="False">                <FontIcon Glyph="&#xE7C3;" FontSize="34" Opacity="0.35" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitle" Text="把文件拖到这里" FontSize="14" HorizontalAlignment="Center" />
                <TextBlock Text="也可以右键新建文件夹或收纳文件"
                           FontSize="12"
                           Opacity="0.55"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Border x:Name="DropOverlay"
                    Margin="6"
                    CornerRadius="10"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Opacity="0.16"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border.BorderBrush>
                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" />
                </Border.BorderBrush>
                <Border.BorderThickness>2</Border.BorderThickness>
                <TextBlock Text="松开以收纳"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </Border>

            <InfoBar x:Name="NotifyBar"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Informational"
                     Margin="8,0,8,8"
                     VerticalAlignment="Bottom"
                     Title="" />
        </Grid>

        <!-- 状态栏 -->
        <Grid x:Name="StatusBar" Grid.Row="2" Height="30" Padding="12,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Opacity="0.6"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="SizeText" FontSize="11" Opacity="0.6" />
                <Button x:Name="MenuButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Width="24" Height="24"
                        ToolTipService.ToolTip="更多"
                        AutomationProperties.Name="更多操作"
                        Click="OnMenuButtonClick">
                    <FontIcon Glyph="&#xE712;" FontSize="11" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
